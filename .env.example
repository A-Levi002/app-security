# Supabase project (Settings -> API)
# Copia este archivo a .env y pega aquí tus credenciales reales.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# MyMappi API key (geocoding/autocomplete/directions) - OPCIONAL.
# Sin key la app usa servicios gratis: Photon (geocoding/búsqueda) y
# OSRM público (rutas). Con key, MyMappi toma prioridad:
#   https://mymappi.io | solicita tu api key.
# EXPO_PUBLIC_MYMAPPI_API_KEY=TU-MYMAPPI-API-KEY
# Base URL custom (solo si el host difiere del default).
# EXPO_PUBLIC_MYMAPPI_BASE_URL=https://api.mymappi.com

# Los mapas usan MapLibre con tiles gratuitos (OSM/Carto/Esri), sin API key.
# Ya NO se usa Google Maps ni EXPO_PUBLIC_GOOGLE_MAPS_API_KEY.

# La IA del chat (Gemini) NO se configura aquí.
# Se configura como Secret "GEMINI_API_KEY" en Supabase →
#   Project Settings → Edge Functions → Secrets.
# La usan analyze-incident y ai-respond (LangChain).
# Ver: backend/README.md y backend/supabase/functions/analyze-incident/README.md