# Supabase project (Settings -> API)
# Copia este archivo a .env y pega aquí tus credenciales reales.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Google Maps API key (Android) - https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=TU-GOOGLE-MAPS-API-KEY

# La IA del chat (Gemini) NO se configura aquí.
# Se configura como Secret "GEMINI_API_KEY" en Supabase →
#   Project Settings → Edge Functions → Secrets.
# Ver: backend/supabase/functions/analyze-incident/README.md